# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection used by the app (Neon/Supabase pooler)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# Direct connection used by prisma migrate
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
SESSION_HOURS="12"

# ─── First admin account (used by the seed script only) ──────────────────────
SEED_ADMIN_NAME="Harshit Narang"
SEED_ADMIN_EMAIL="admin@hnproperties.in"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
# Set to false to seed roles, locations and categories with no demo data
SEED_DEMO="true"
SEED_DEMO_PASSWORD="demo-password-123"

# ─── Storage ─────────────────────────────────────────────────────────────────
# none | vercel-blob
# local = save into public/uploads (development). vercel-blob = production.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ─── Email (optional) ────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="HN Properties <hnpropertiesjbp@gmail.com>"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Required header for /api/cron/daily: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ─── Public site configuration ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="HN Properties"
NEXT_PUBLIC_CONTACT_PHONE="9713041004"
NEXT_PUBLIC_CONTACT_WHATSAPP="9713041004"
NEXT_PUBLIC_CONTACT_EMAIL="hnpropertiesjbp@gmail.com"
NEXT_PUBLIC_CONTACT_ADDRESS="Jabalpur, Madhya Pradesh"
NEXT_PUBLIC_DEFAULT_CITY="Jabalpur"
NEXT_PUBLIC_DEFAULT_STATE="Madhya Pradesh"
# Live updates on public pages: set to false to rely on caching alone
NEXT_PUBLIC_LIVE_UPDATES="true"

# Google Maps: enables place search on the owner forms. Requires a billing account
# even for the free allowance — leave empty to use the free picker instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# MapTiler: clearer map tiles than the default OpenStreetMap style.
# Free tier is 100,000 loads a month and needs no card — maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/hnpropertiesjbp"
NEXT_PUBLIC_FACEBOOK_URL=""
