# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection used by the app (Neon/Supabase pooler)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
# Direct connection used by prisma migrate
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
SESSION_HOURS="12"

# ─── First admin account (used by the seed script only) ──────────────────────
SEED_ADMIN_NAME="Harshit Narang"
SEED_ADMIN_EMAIL="admin@hnproperties.in"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
# Set to false to seed roles, locations and categories with no demo data
SEED_DEMO="true"
SEED_DEMO_PASSWORD="demo-password-123"

# ─── Storage ─────────────────────────────────────────────────────────────────
# none | vercel-blob
# local = save into public/uploads (development). vercel-blob = production.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# Documents (title deeds, agreements, IDs) live in a SEPARATE private Blob store.
# Private stores refuse unauthenticated reads, so the URL alone grants nothing.
# Create one with:  vercel blob create-store hn-documents --access private
#
# Set ONE of the two below. There is deliberately no fallback to the public store
# above — missing configuration fails the upload rather than quietly writing a
# document where anyone can read it.
#
# Preferred: OIDC. Vercel issues a short-lived token per deployment and rotates
# it, so no long-lived secret sits in the environment. Take the value from the
# BLOB_STORE_ID that Vercel adds when you connect the private store (give it a
# distinct prefix, or copy the value here) and run `vercel env pull` locally.
BLOB_PRIVATE_STORE_ID=

# Fallback: a long-lived static token. Use when running outside Vercel, or if the
# private store has not been moved to OIDC.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# ─── Email (optional) ────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="HN Properties <hnpropertiesjbp@gmail.com>"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Required header for /api/cron/daily: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ─── Web Push notifications (VAPID) ───────────────────────────────────────────
# Browser / installed-PWA / TWA push for staff (CRM) and signed-in owners.
# Generate ONE keypair and reuse it across both hosts (www + crm):
#   npx web-push generate-vapid-keys
# Put the PUBLIC key in BOTH VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY —
# the NEXT_PUBLIC_ copy is sent to the browser to subscribe and is not a secret.
# VAPID_PRIVATE_KEY is a secret: server only, never exposed to the client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# A mailto: (or https) URL identifying the sender, required by the push services.
VAPID_SUBJECT="mailto:hnpropertiesjbp@gmail.com"

# ─── Public site configuration ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="HN Properties"
NEXT_PUBLIC_CONTACT_PHONE="9713041004"
NEXT_PUBLIC_CONTACT_WHATSAPP="9713041004"
NEXT_PUBLIC_CONTACT_EMAIL="hnpropertiesjbp@gmail.com"
NEXT_PUBLIC_CONTACT_ADDRESS="Jabalpur, Madhya Pradesh"
NEXT_PUBLIC_DEFAULT_CITY="Jabalpur"
NEXT_PUBLIC_DEFAULT_STATE="Madhya Pradesh"
# Live updates on public pages: set to false to rely on caching alone
NEXT_PUBLIC_LIVE_UPDATES="true"

# Google Maps: enables place search on the owner forms. Requires a billing account
# even for the free allowance — leave empty to use the free picker instead.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# MapTiler: clearer map tiles than the default OpenStreetMap style.
# Free tier is 100,000 loads a month and needs no card — maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/hnpropertiesjbp"
NEXT_PUBLIC_FACEBOOK_URL=""

# Sign in with Google, for owners managing their own listings.
# From console.cloud.google.com/auth/clients — Web application client.
# Registered redirect URIs must include every host the site answers on:
#   https://www.hnproperties.co.in/api/auth/google/callback
#   https://hnproperties.co.in/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
"# trigger deploy" 
